{
  "name": "emory-decision-making-megalab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "calendar": "node scripts/generate-calendar.mjs",
    "prebuild": "npm run calendar",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:topics:db": "python3 scripts/test-topics-db.py",
    "test:topics:browser": "python3 scripts/test-topics-browser.py",
    "postbuild": "npm run test:meeting-urls && npm run test:schedule-events",
    "test:meeting-urls": "node scripts/test-meeting-urls.mjs",
    "test:schedule-events": "node scripts/test-schedule-events.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@supabase/supabase-js": "2.112.4",
    "astro": "7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.2"
  }
}
