---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  compact?: boolean;
}

const { eyebrow, title, intro, compact = false } = Astro.props;
---

<header class:list={["page-intro", "shell", { "page-intro-compact": compact }]}>
  <p class="eyebrow">{eyebrow}</p>
  <div>
    <h1>{title}</h1>
    <p>{intro}</p>
  </div>
</header>
