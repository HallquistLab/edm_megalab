---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  titleId?: string;
}

const { eyebrow, title, intro, titleId } = Astro.props;
---

<header class="page-intro shell">
  <p class="eyebrow">{eyebrow}</p>
  <h1 id={titleId}>{title}</h1>
  <div class="page-intro-description">
    <slot>{intro && <p>{intro}</p>}</slot>
  </div>
</header>
