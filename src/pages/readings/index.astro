---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { readings } from "../../lib/content";
import { keywordTone } from "../../lib/keywords";

const keywords = [...new Set(readings.flatMap((reading) => reading.keywords))].sort(
  (left, right) => left.localeCompare(right),
);
---

<BaseLayout
  title="Reading room"
  description="Curated recent readings for EDM Megalab discussions and workshops."
>
  <PageIntro
    eyebrow="EDM Megalab · Curated, not exhaustive"
    title="Reading room"
    intro="Search the collection or select a research keyword to find related articles."
  />

  <section class="reading-tools shell" aria-label="Reading filters">
    <label class="search-box">
      <span class="sr-only">Search readings</span>
      <span aria-hidden="true">⌕</span>
      <input
        type="search"
        placeholder="Search by title, author, journal, or topic…"
        data-search
      />
    </label>
    <div class="reading-control-panel">
      <div class="reading-filter-group">
        <span>Keywords</span>
        <div class="keyword-filter-bar" role="group" aria-label="Filter by keyword">
          <button
            class="keyword-badge keyword-all active"
            type="button"
            data-reading-keyword="all"
            aria-pressed="true"
          >
            All topics
          </button>
          {
            keywords.map((keyword) => (
              <button
                class={`keyword-badge ${keywordTone(keyword)}`}
                type="button"
                data-reading-keyword={keyword.toLowerCase()}
                aria-pressed="false"
              >
                {keyword}
              </button>
            ))
          }
        </div>
      </div>
      <div class="reading-filter-group reading-status-controls">
        <span>Discussion status</span>
        <div class="filter-bar" role="group" aria-label="Filter by discussion status">
          {
            [
              ["all", "All readings"],
              ["active", "Not yet presented"],
              ["presented", "Presented"],
            ].map(([value, label], index) => (
              <button
                class:list={{ active: index === 0 }}
                type="button"
                data-reading-status={value}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                {label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="reading-view-options">
        <p class="reading-count" data-reading-count aria-live="polite">
          {readings.length} articles
        </p>
        <div class="view-toggle" role="group" aria-label="Choose reading display">
          <span>View</span>
          <button type="button" data-reading-view="cards" aria-pressed="true">
            Cards
          </button>
          <button type="button" data-reading-view="list" aria-pressed="false">
            List
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="reading-grid shell" data-reading-grid data-view="cards">
    {
      readings.map((reading, index) => (
        <article
          class="reading-card"
          data-presented={String(reading.presented)}
          data-keywords={reading.keywords
            .map((keyword) => keyword.toLowerCase())
            .join("|")}
          data-searchable={`${reading.title} ${reading.authors} ${reading.journal} ${reading.keywords.join(" ")}`.toLowerCase()}
        >
          <div class="reading-card-top">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <span
              class:list={[
                "reading-status",
                reading.presented ? "reading-status-presented" : "reading-status-active",
              ]}
            >
              {reading.presented ? "Presented" : "Not yet presented"}
            </span>
          </div>
          <div class="reading-card-main">
            <p class="citation">
              {reading.authors} · {reading.year}
            </p>
            <h2>
              <a href={reading.doi}>{reading.title}</a>
            </h2>
            <p class="journal">
              {reading.journal}
              {reading.citation && `, ${reading.citation}`}
            </p>
          </div>
          <div class="reading-keywords" aria-label={`Keywords for ${reading.title}`}>
            {reading.keywords.map((keyword) => (
              <button
                class={`keyword-badge ${keywordTone(keyword)}`}
                type="button"
                data-reading-keyword={keyword.toLowerCase()}
                aria-pressed="false"
              >
                {keyword}
              </button>
            ))}
          </div>
          <p class="why">{reading.why}</p>
          <a href={reading.doi} aria-label={`Open ${reading.title}`}>
            Read paper <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))
    }
    <p class="empty-state reading-empty" hidden>No readings match that search.</p>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>("[data-search]");
    const keywordButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-reading-keyword]"),
    );
    const statusButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-reading-status]"),
    );
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".reading-card"));
    const empty = document.querySelector<HTMLElement>(".reading-empty");
    const grid = document.querySelector<HTMLElement>("[data-reading-grid]");
    const count = document.querySelector<HTMLElement>("[data-reading-count]");
    const viewButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-reading-view]"),
    );
    let keyword = "all";
    let discussionStatus = "all";

    const update = () => {
      const query = search?.value.trim().toLowerCase() ?? "";
      let visibleCount = 0;
      cards.forEach((card) => {
        const cardKeywords = (card.dataset.keywords ?? "").split("|");
        const matchesKeyword = keyword === "all" || cardKeywords.includes(keyword);
        const isPresented = card.dataset.presented === "true";
        const matchesStatus =
          discussionStatus === "all" ||
          (discussionStatus === "presented" ? isPresented : !isPresented);
        const matchesSearch = card.dataset.searchable?.includes(query) ?? false;
        card.hidden = !(matchesKeyword && matchesStatus && matchesSearch);
        if (!card.hidden) visibleCount += 1;
      });
      if (empty) empty.hidden = visibleCount > 0;
      if (count)
        count.textContent = `${visibleCount} article${visibleCount === 1 ? "" : "s"}`;
    };

    const setView = (view: "cards" | "list") => {
      if (grid) grid.dataset.view = view;
      viewButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.readingView === view));
      });
      try {
        localStorage.setItem("edm-reading-view", view);
      } catch {
        // The view still works when browser storage is unavailable.
      }
    };

    try {
      if (localStorage.getItem("edm-reading-view") === "list") setView("list");
    } catch {
      // Keep the default card view when browser storage is unavailable.
    }

    search?.addEventListener("input", update);
    keywordButtons.forEach((button) => {
      button.addEventListener("click", () => {
        keyword = button.dataset.readingKeyword ?? "all";
        keywordButtons.forEach((item) => {
          const active = item.dataset.readingKeyword === keyword;
          item.classList.toggle("active", active);
          item.setAttribute("aria-pressed", String(active));
        });
        update();
      });
    });
    statusButtons.forEach((button) => {
      button.addEventListener("click", () => {
        discussionStatus = button.dataset.readingStatus ?? "all";
        statusButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle("active", active);
          item.setAttribute("aria-pressed", String(active));
        });
        update();
      });
    });
    viewButtons.forEach((button) => {
      button.addEventListener("click", () => {
        setView(button.dataset.readingView === "list" ? "list" : "cards");
      });
    });
  </script>
</BaseLayout>
