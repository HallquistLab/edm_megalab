---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { readings } from "../../lib/content";
import { keywordTone } from "../../lib/keywords";

const queue = readings.slice(3, 7);
---

<BaseLayout
  title="Article queue"
  description="Propose articles and help choose future EDM Megalab discussions."
>
  <PageIntro
    eyebrow="EDM Megalab · Article queue"
    title="What should we read next?"
    intro="Suggest a paper for a future discussion. Coordinators review suggestions before adding them to the public queue."
    compact
  />

  <section class="queue-actions shell">
    <div>
      <span class="live-dot" aria-hidden="true"></span>
      <p data-queue-status aria-live="polite">
        <strong>Member queue</strong> · Loading live articles…
      </p>
    </div>
    <div class="queue-action-buttons">
      <details class="member-access" data-member-panel>
        <summary class="button button-secondary">
          <span data-member-label>Sign in</span>
          <span aria-hidden="true">＋</span>
        </summary>
        <div class="member-access-panel">
          <div class="member-access-copy" data-member-copy>
            <strong>Sign in with your Emory email.</strong>
            <p>Suggest articles or vote using a secure email link—no password needed.</p>
          </div>
          <form class="inline-auth" data-auth-form>
            <label for="member-email">Emory email</label>
            <div>
              <input
                id="member-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="name@emory.edu"
                required
              />
              <button class="button button-primary" type="submit">Email me a link</button>
            </div>
            <p class="form-status" data-auth-status aria-live="polite"></p>
          </form>
          <div class="signed-in-state" data-signed-in hidden>
            <p>Signed in as <strong data-member-email></strong></p>
            <button class="text-button" type="button" data-sign-out>Sign out</button>
          </div>
        </div>
      </details>
      <button
        class="button button-primary"
        type="button"
        data-open-proposal
        aria-controls="article-proposal"
        aria-expanded="false"
      >
        Suggest an article <span aria-hidden="true">＋</span>
      </button>
    </div>
  </section>

  <section
    class="proposal-drawer shell"
    id="article-proposal"
    data-proposal-drawer
    hidden
  >
    <div class="form-heading">
      <div>
        <p class="eyebrow">New suggestion</p>
        <h2>Suggest an article</h2>
      </div>
      <button class="text-button" type="button" data-close-proposal>Close</button>
    </div>
    <form class="proposal-form" data-proposal-form>
      <label>
        Your name
        <input
          name="submitter_name"
          autocomplete="name"
          required
          minlength="2"
          maxlength="120"
        />
      </label>
      <label>
        Article title
        <input name="title" required minlength="3" maxlength="300" />
      </label>
      <label class="form-wide">
        DOI or stable link
        <input name="url" type="url" placeholder="https://doi.org/…" required />
      </label>
      <label class="form-wide">
        Full citation
        <textarea name="citation" rows="2" required maxlength="1000"></textarea>
      </label>
      <label>
        Topic or theme
        <input
          name="topic"
          placeholder="e.g. computational psychiatry"
          required
          maxlength="120"
        />
      </label>
      <label class="form-wide">
        Why should EDM Megalab discuss it?
        <textarea name="rationale" rows="4" required minlength="10" maxlength="3000"
        ></textarea>
      </label>
      <div class="form-submit form-wide">
        <p class="form-status" data-proposal-status aria-live="polite"></p>
        <button class="button button-primary" type="submit">Send to coordinators</button>
      </div>
    </form>
  </section>

  <section class="ballot-section" id="ballot" data-ballot-section hidden>
    <div class="shell">
      <header class="ballot-heading">
        <div>
          <p class="eyebrow" data-poll-eyebrow></p>
          <h2 data-poll-title></h2>
        </div>
        <div class="ballot-instructions">
          <span data-poll-limit></span>
          <p data-poll-instructions></p>
        </div>
      </header>
      <div class="ballot-grid" data-ballot-grid></div>
      <p class="demo-note" data-ballot-note></p>
      <p class="ballot-selection-note">
        Coordinators choose a paper based on votes, the meeting schedule, and
        discussion-leader availability.
      </p>
    </div>
  </section>

  <section class="article-queue shell">
    <div class="section-heading compact-heading">
      <div>
        <p class="eyebrow">The queue</p>
        <h2>Suggested articles</h2>
      </div>
    </div>
    <div class="queue-list" data-queue-list>
      {
        queue.map((article, index) => (
          <article>
            <span class="queue-rank">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <span
                class={`keyword-badge keyword-static ${keywordTone(article.keywords[0])}`}
              >
                {article.keywords[0]}
              </span>
              <h3>{article.title}</h3>
              <p>
                {article.authors} · {article.journal} · {article.year}
              </p>
            </div>
            <p>{article.why}</p>
            <a href={article.doi} aria-label={`Read ${article.title}`}>
              ↗
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <script>
    import "../../scripts/articles";
  </script>
</BaseLayout>
