---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { readings } from "../../lib/content";

const ballot = readings.slice(0, 3);
const queue = readings.slice(3, 7);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Article queue"
  description="Propose articles and help choose future Emory Decision-Making Megalab discussions."
>
  <PageIntro
    eyebrow="Article queue · Shaped by the group"
    title="What should we read next?"
    intro="Add a paper when it feels worth the group’s time. Coordinators can turn a short list into an approval ballot for a future meeting."
    compact
  />

  <section class="queue-actions shell">
    <div>
      <span class="live-dot" aria-hidden="true"></span>
      <p data-queue-status aria-live="polite">
        <strong>Member queue</strong> · Loading live articles…
      </p>
    </div>
    <div class="queue-action-buttons">
      <details class="member-access" data-member-panel>
        <summary class="button button-secondary">
          Member access <span aria-hidden="true">＋</span>
        </summary>
        <div class="member-access-panel">
          <div class="member-access-copy">
            <strong>Sign in with your Emory email.</strong>
            <p>Suggest articles or vote using a secure email link—no password needed.</p>
          </div>
          <form class="inline-auth" data-auth-form>
            <label for="member-email">Emory email</label>
            <div>
              <input
                id="member-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="name@emory.edu"
                required
              />
              <button class="button button-primary" type="submit">Email me a link</button>
            </div>
            <p class="form-status" data-auth-status aria-live="polite"></p>
          </form>
          <div class="signed-in-state" data-signed-in hidden>
            <p>Signed in as <strong data-member-email></strong></p>
            <button class="text-button" type="button" data-sign-out>Sign out</button>
          </div>
        </div>
      </details>
      <a class="button button-secondary" href={`${base}admin/`}>
        Coordinator console <span aria-hidden="true">→</span>
      </a>
      <button class="button button-primary" type="button" data-open-proposal>
        Suggest an article <span aria-hidden="true">＋</span>
      </button>
    </div>
  </section>

  <section class="proposal-drawer shell" data-proposal-drawer hidden>
    <div class="form-heading">
      <div>
        <p class="eyebrow">New suggestion</p>
        <h2>Put a paper on the group’s radar.</h2>
      </div>
      <button class="text-button" type="button" data-close-proposal>Close</button>
    </div>
    <form class="proposal-form" data-proposal-form>
      <label>
        Your name
        <input
          name="submitter_name"
          autocomplete="name"
          required
          minlength="2"
          maxlength="120"
        />
      </label>
      <label>
        Article title
        <input name="title" required minlength="3" maxlength="300" />
      </label>
      <label class="form-wide">
        DOI or stable link
        <input name="url" type="url" placeholder="https://doi.org/…" required />
      </label>
      <label class="form-wide">
        Full citation
        <textarea name="citation" rows="2" required maxlength="1000"></textarea>
      </label>
      <label>
        Topic or theme
        <input
          name="topic"
          placeholder="e.g. computational psychiatry"
          required
          maxlength="120"
        />
      </label>
      <label class="form-wide">
        Why should the group discuss it?
        <textarea name="rationale" rows="4" required minlength="10" maxlength="3000"
        ></textarea>
      </label>
      <label class="form-wide">
        Possible discussion questions <span>(optional)</span>
        <textarea name="questions" rows="3" maxlength="3000"></textarea>
      </label>
      <div class="form-submit form-wide">
        <p class="form-status" data-proposal-status aria-live="polite"></p>
        <button class="button button-primary" type="submit">Send to coordinators</button>
      </div>
    </form>
  </section>

  <section class="ballot-section" id="ballot">
    <div class="shell">
      <header class="ballot-heading">
        <div>
          <p class="eyebrow" data-poll-eyebrow>Preview poll · Fall 2026</p>
          <h2 data-poll-title>Approve up to three<br /><em>for the meeting.</em></h2>
        </div>
        <div class="ballot-instructions">
          <span data-poll-limit>Up to three approvals</span>
          <p data-poll-instructions>
            Select every paper you would genuinely like to discuss, up to the ballot’s
            three-choice limit. You may change your choices until the poll closes.
          </p>
        </div>
      </header>
      <div class="ballot-grid" data-ballot-grid>
        {
          ballot.map((article, index) => (
            <article class="ballot-card">
              <div class="ballot-card-top">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span class="vote-count">
                  <strong>{[8, 6, 4][index]}</strong> approvals
                </span>
              </div>
              <div>
                <p>
                  {article.authors} · {article.year}
                </p>
                <h3>{article.title}</h3>
                <span>{article.journal}</span>
              </div>
              <a href={article.doi}>
                Read paper <span aria-hidden="true">↗</span>
              </a>
              <button type="button" disabled>
                Sign in to approve
              </button>
            </article>
          ))
        }
      </div>
      <p class="demo-note" data-ballot-note>
        Preview approval ballot · Live results appear when Supabase is connected.
      </p>
    </div>
  </section>

  <section class="article-queue shell">
    <div class="section-heading compact-heading">
      <div>
        <p class="eyebrow">The queue</p>
        <h2>On the group’s radar.</h2>
      </div>
      <p>
        Articles proposed for discussion appear here. We will add queued papers to a poll
        when we have an open slot.
      </p>
    </div>
    <div class="queue-list" data-queue-list>
      {
        queue.map((article, index) => (
          <article>
            <span class="queue-rank">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <span class="collection collection-priority">{article.topic}</span>
              <h3>{article.title}</h3>
              <p>
                {article.authors} · {article.journal} · {article.year}
              </p>
            </div>
            <p>{article.why}</p>
            <a href={article.doi} aria-label={`Read ${article.title}`}>
              ↗
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="voting-guide" id="voting-guide">
    <div class="shell">
      <p class="eyebrow">How it works</p>
      <ol>
        <li>
          <span>01</span><div>
            <h2>Suggest</h2><p>
              Sign in with an Emory email and share the citation, link, rationale, and
              optional discussion questions.
            </p>
          </div>
        </li>
        <li>
          <span>02</span><div>
            <h2>Curate</h2><p>
              A coordinator reviews new suggestions, places promising papers in the public
              queue, and selects a short poll slate.
            </p>
          </div>
        </li>
        <li>
          <span>03</span><div>
            <h2>Approve</h2><p>
              Members choose up to three papers they would genuinely like to discuss. The
              database enforces the limit for every ballot.
            </p>
          </div>
        </li>
        <li>
          <span>04</span><div>
            <h2>Schedule</h2><p>
              Organizers use the result alongside timing, thematic balance, and
              discussion-leader availability—not vote count alone.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <script>
    import "../../scripts/articles";
  </script>
</BaseLayout>
