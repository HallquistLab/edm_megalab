---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import labs from "../../data/labs.json";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="About us"
  description="A biweekly forum for colleagues across Emory, supported by five core organizing labs and welcoming participation across departments."
>
  <PageIntro
    eyebrow="Emory Decision-Making Megalab"
    title="About us"
    intro="A biweekly forum for colleagues across Emory to exchange ideas about decision-making, computational approaches, and clinical science."
    compact
  />

  <section class="about-purpose shell" aria-labelledby="about-mission-title">
    <div class="about-mission">
      <h2 class="eyebrow" id="about-mission-title">Our mission</h2>
      <p class="about-lead">
        EDM Megalab brings together faculty, trainees, and research staff across Emory to
        understand how people learn, value options, and make decisions—and how these
        processes relate to mental health.
      </p>
      <p>
        Our meetings create a regular space for work that benefits from perspectives
        beyond a single lab. We discuss emerging findings, work through methodological
        challenges, and connect questions across decision neuroscience, computational
        psychiatry, affective science, and quantitative psychology.
      </p>
      <p>
        Colleagues from across Emory, including Psychiatry, are welcome to join
        discussions, present work in progress, suggest readings, or lead a methods
        session. You do not need to be affiliated with a core lab to take part or help
        shape the program.
      </p>
    </div>
    <div class="about-aspiration" aria-labelledby="about-aspiration-title">
      <h2 class="eyebrow" id="about-aspiration-title">Our aspiration</h2>
      <p>
        Build a lasting, collaborative community across Emory where sharing an unfinished
        idea is routine, methods travel readily between labs, and trainees help shape the
        scientific conversation.
      </p>
      <p>
        We hope that sustained exchange leads to stronger studies, shared tools, and new
        collaborations that advance our understanding of behavior and mental health.
      </p>
    </div>
  </section>

  <section class="about-goals shell" aria-labelledby="about-goals-title">
    <h2 class="eyebrow" id="about-goals-title">Our goals</h2>
    <div class="about-goal-grid">
      <article>
        <h3>Strengthen work in progress</h3>
        <p>
          Offer constructive, specific feedback while projects are still taking shape:
          from a study question or task design to an analysis, grant, or manuscript.
        </p>
      </article>
      <article>
        <h3>Share practical methods</h3>
        <p>
          Make technical knowledge usable through workshops, worked examples, and candid
          discussion of modeling, measurement, and neuroimaging decisions.
        </p>
      </article>
      <article>
        <h3>Connect ideas across labs</h3>
        <p>
          Read consequential papers together, examine emerging topics, and identify
          questions that benefit from our complementary approaches and expertise.
        </p>
      </article>
    </div>
  </section>

  <section class="about-labs shell" aria-labelledby="about-labs-title">
    <header class="about-labs-heading">
      <p class="eyebrow">Core organizing labs</p>
      <h2 id="about-labs-title">Five core labs, a wider community.</h2>
      <p>
        The Treadway, Brown, Hitchcock, Hallquist, and Kragel labs help organize and
        sustain the Megalab. Their complementary interests provide a starting point for a
        broader conversation across Emory, shaped by everyone who participates.
      </p>
    </header>
    <div class="about-lab-grid">
      {
        labs.map((lab) => (
          <article class="about-lab" aria-labelledby={`${lab.id}-title`}>
            <header>
              <p class="eyebrow">{lab.shortName}</p>
              <h3 id={`${lab.id}-title`}>{lab.pi}</h3>
              <p class="about-lab-name">{lab.name}</p>
            </header>
            <p>{lab.piOverview}</p>
            <p>{lab.researchOverview}</p>
            <ul class="about-lab-links" aria-label={`${lab.pi} lab and profile links`}>
              {lab.links.map((link) => (
                <li>
                  <a href={link.url}>
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <p class="about-source-note">
      Profiles adapted from the public lab and university pages linked above.
    </p>
  </section>

  <section class="about-participate shell" aria-labelledby="about-participate-title">
    <div>
      <h2 id="about-participate-title">Bring a question to the next meeting.</h2>
      <p>Suggest a work in progress, a methods session, or a topic for discussion.</p>
    </div>
    <div class="button-row">
      <a class="button button-primary" href={`${base}propose/`}>Propose a Session</a>
      <a class="button button-secondary" href={`${base}schedule/`}>View the schedule</a>
    </div>
  </section>
</BaseLayout>
